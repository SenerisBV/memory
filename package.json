{
  "name": "@seneris/memory",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./registry": "./src/registry.ts",
    "./host": "./src/host.ts",
    "./migrate": "./src/migrate.ts",
    "./adoptLegacy": "./src/adoptLegacy.ts"
  },
  "scripts": {
    "db:generate": "bun --env-file=.env drizzle-kit generate",
    "db:migrate": "bun --env-file=.env src/cli-migrate.ts",
    "db:test:setup": "bun --env-file=.env.test src/cli-migrate.ts",
    "db:check": "bun --env-file=.env src/cli-check.ts",
    "test": "bun --env-file=.env.test test",
    "typecheck": "tsc --noEmit",
    "consolidate": "bun scripts/consolidate-store.ts",
    "example:stranger": "bun --env-file=.env examples/stranger.ts"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "drizzle-orm": "^0.45.2",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/pg": "8.20.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.0"
  },
  "overrides": { "pg": "8.22.0", "@types/pg": "8.20.0" }
}
