# Copy to .env.test. `bun run test` loads this file. tests/db-guard.ts refuses
# any database whose name does not end in _test.
DATABASE_URL=postgresql://you@localhost:5432/memory_test

# Optional: comma-separated names src/ must never contain (see tests/guardNames.ts).
# Leave unset to use the generic default list.
# MEMORY_GUARD_NAMES=
